pragma solidity 0.8.30;

import "forge-std/Test.sol";
import { HonkVerifier } from "../src/verifier/HonkVerifier.sol";

/// Runs proofs generated by circuits/scripts/gen_fixtures.sh through the generated verifier.
contract RealProofTest is Test {
    uint256 internal constant FIELD = 21888242871839275222246405745257275088548364400416034343698204186575808495617;

    HonkVerifier internal verifier;

    function setUp() public {
        verifier = new HonkVerifier();
    }

    function _load(string memory note) internal view returns (bytes memory proof, bytes32[] memory inputs) {
        string memory json = vm.readFile(string.concat("test/fixtures/", note, ".json"));
        proof = vm.parseJsonBytes(json, ".proof");
        inputs = vm.parseJsonBytes32Array(json, ".publicInputs");
    }

    function _accepts(bytes memory proof, bytes32[] memory inputs) internal view returns (bool) {
        try verifier.verify(proof, inputs) returns (bool ok) {
            return ok;
        } catch {
            return false;
        }
    }

    function test_validProofsVerify() public view {
        (bytes memory proof0, bytes32[] memory inputs0) = _load("note0");
        (bytes memory proof1, bytes32[] memory inputs1) = _load("note1");
        assertTrue(_accepts(proof0, inputs0));
        assertTrue(_accepts(proof1, inputs1));
    }

    function test_changingAnyPublicInputInvalidatesTheProof() public view {
        (bytes memory proof, bytes32[] memory inputs) = _load("note1");
        string[5] memory names = ["root", "nullifierHash", "recipient", "relayer", "fee"];
        for (uint256 i = 0; i < inputs.length; i++) {
            bytes32 original = inputs[i];
            inputs[i] = bytes32(uint256(original) + 1);
            assertFalse(_accepts(proof, inputs), names[i]);
            inputs[i] = original;
        }
    }

    function test_proofForOneNoteDoesNotVerifyForAnother() public view {
        (bytes memory proof0, ) = _load("note0");
        (, bytes32[] memory inputs1) = _load("note1");
        assertFalse(_accepts(proof0, inputs1));
    }

    /// The same nullifier hash plus the field modulus must not pass, or one note could be spent twice.
    function test_nullifierHashPlusFieldModulusIsRejected() public view {
        (bytes memory proof, bytes32[] memory inputs) = _load("note1");
        inputs[1] = bytes32(uint256(inputs[1]) + FIELD);
        assertFalse(_accepts(proof, inputs));
    }
}
